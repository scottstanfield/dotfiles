{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none"
  },
  "display": {
    "key": {
      "width": 15
    }
  },
  "modules": [
    {
      "type": "host",
      "key": " · Machine",
      "format": "{name} "
    },
    {
      "type": "cpu",
      "key": " · CPU",
      "format": "{name}"
    },
    {
      "type": "kernel",
      "key": " · Kernel"
    },
    {
      "type": "os",
      "key": " · OS",
      "format": "{pretty-name} {arch}"
    },
    {
      "type": "localip",
      "key": " · IP",
      "format": "{ipv4} {ifname}"
    },
    {
      "type": "uptime",
      "key": " · Uptime"
    },
    {
      "type": "loadavg",
      "key": " · Load"
    },
    {
      "type": "cpu",
      "key": " ○ CPU",
      "format": "{name}"
    }
  ]
}
