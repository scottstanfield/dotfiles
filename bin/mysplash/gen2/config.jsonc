{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small"
    },
    "display": {
        "constants": [
            "\u2022 ",
            "\u2588\u2588 "
        ],
        "separator": "  "
    },
    "modules": [
        {
            "type": "host",
            "key": "{$1}Computer",
            "keyColor": "38;5;210"
        },
        {
            "type": "os",
            "key": "{$1}OS      ",
            "keyColor": "38;5;84"
        },
        {
            "type": "kernel",
            "key": "{$1}Kernel  ",
            "keyColor": "38;5;147"
        },
        {
            "type": "uptime",
            "key": "{$1}Uptime  ",
            "keyColor": "38;5;44"
        },
        {
            "type": "localip",
            "key": "{$1}IP      ",
            "keyColor": "38;5;75"
        },
        {
            "type": "title",
            "key": "{$1}Hostname",
            "keyColor": "38;5;123",
            "format": "{host-name-colored}"
        }
    ]
}
