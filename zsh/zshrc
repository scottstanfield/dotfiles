# Source a file if it exists; warn and continue if it doesn't.
# Accepts a path relative to $PLUGIN_DIR or an absolute path.
safe_source() {
    local f=$1
    [[ $f = /* ]] || f=$PLUGIN_DIR/$f
    if [[ -f $f ]]; then
        source $f
    else
        print -u2 "warning: $f not found, skipping"
    fi
}

# 1. Completion system: fpath, zstyles, compinit, options.
setup_completion() {
    fpath=(
        /opt/homebrew/share/zsh/site-functions
        ${HOME}/.local/share/zsh/completions
        $fpath
    )
    typeset -gU fpath

    zstyle ':completion:*' menu select
    zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=*' 'l:|=* r:|=*'
    zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
    zstyle ':completion:*' completer _expand _complete _match _approximate
    zstyle ':completion:*' list-suffixes
    zstyle ':completion:*' expand prefix suffix

    autoload -Uz compinit
    local zcd=${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompdump
    mkdir -p ${zcd:h}
    # Full security check once a day; otherwise trust the cache.
    if [[ -n $zcd(#qN.mh+24) ]]; then
        compinit -d $zcd
    else
        compinit -C -d $zcd
    fi
    [[ -f $zcd && ( ! -f $zcd.zwc || $zcd -nt $zcd.zwc ) ]] && \
        zcompile -R -- $zcd.zwc $zcd

    setopt complete_in_word   # cd /ho/sco/tm<TAB> expands inline
    setopt auto_menu          # show completion menu on successive tab presses
}

# 2. Plugins: prompt theme, autosuggestions, syntax highlighting, p10k config.
setup_plugins() {
    safe_source powerlevel10k/powerlevel10k.zsh-theme              # prompt theme
    safe_source fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh  # syntax coloring (load last)
    [[ -f ${XDG_CONFIG_HOME}/zsh/p10k.zsh ]] && source ${XDG_CONFIG_HOME}/zsh/p10k.zsh
}

# 3. fast-syntax-highlighting theme + style tweaks (runs after setup_plugins).
setup_fsh_theme() {
    local marker=${XDG_DATA_HOME:-$HOME/.local/share}/zsh/fast-syntax-highlighting-configured
    if (( $+functions[fast-theme] )) && [[ ! -f $marker ]]; then
        fast-theme -q default
        touch $marker
    fi
    if (( ${+FAST_HIGHLIGHT_STYLES} )); then
        FAST_HIGHLIGHT_STYLES[${FAST_THEME_NAME}path]='fg=cyan'
        FAST_HIGHLIGHT_STYLES[${FAST_THEME_NAME}path-to-dir]='fg=cyan,underline'
        FAST_HIGHLIGHT_STYLES[${FAST_THEME_NAME}comment]='fg=gray'
    fi
}

# 4. ssh-agent: reuse running agent or start a new one.
setup_ssh_agent() {
    # If we can already reach an agent (with or without keys), reuse it.
    ssh-add -l &>/dev/null
    [[ $? -ne 2 ]] && return   # exit 0 = has keys, 1 = empty but alive; both fine

    # Try the saved env from a previous session.
    [[ -f $HOME/.ssh-agent-env ]] && source $HOME/.ssh-agent-env >/dev/null
    ssh-add -l &>/dev/null
    [[ $? -ne 2 ]] && return   # the saved agent is alive — reuse it

    # No reachable agent anywhere; start a fresh one.
    ssh-agent > $HOME/.ssh-agent-env
    chmod 600 $HOME/.ssh-agent-env
    source $HOME/.ssh-agent-env >/dev/null
}

# Run them in order.
setup_plugins
setup_fsh_theme
setup_ssh_agent
setup_completion

