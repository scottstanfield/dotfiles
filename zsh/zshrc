# envgrep or @
# Quick search for environment varibles. Usage:
# @ xdg ==> shows all the XDG variables
function @() {
    local exclude='^(PATH|.*COLOR.*)='
    if [ "$#" -eq 0 ]; then
        printenv | sort | grep -vE "$exclude" | less
    else
        printenv | sort | grep -vE "$exclude" | grep --ignore-case --color=always "$1"
    fi
}

