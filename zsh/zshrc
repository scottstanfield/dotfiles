# Scott Stanfield
# Timing startup
# % hyperfine --warmup 2 'zsh -i -c "exit"'
# Should be < 200 ms

# Profile .zshrc startup times by uncommenting this line:
# zmodload zsh/zprof
# Then start a new zsh. Then run and inspect: zprof > startup.txt

() {
    local d
    for d in \
        "${XDG_CACHE_HOME}/zsh" \
        "${XDG_STATE_HOME}/zsh" \
        "${XDG_DATA_HOME}/zsh" \
        "${XDG_STATE_HOME}/bash" \
        "${XDG_STATE_HOME}/less" \
        "${XDG_STATE_HOME}/python" \
        "${XDG_STATE_HOME}/node" \
        "${XDG_STATE_HOME}/psql" \
        "${XDG_STATE_HOME}/r"; do 
        [[ -d $d ]] || mkdir -p "$d"
    done
}

